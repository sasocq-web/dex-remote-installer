#!/usr/bin/python3
"""Unprivileged host laboratory; read-only VM imports outside the sandbox."""
import argparse, json, os, pathlib, pwd, re, socket, subprocess, sys, time
ROOT = pathlib.Path('/srv/sasocq/lab')
LIB = pathlib.Path('/usr/local/lib/sasocq-lab')
SLICE = 'codex-workers-lab.slice'

def name_arg(value):
    if not re.fullmatch('[a-z][a-z0-9-]{0,39}', value):
        raise argparse.ArgumentTypeError('Use 1 a 40 letras minúsculas, números e hífens.')
    return value

def unit(name): return 'sasocq-lab-' + name + '.service'
def paths(name): return ROOT / name, pathlib.Path('/run/user/1001/sasocq-lab') / name

def call(name, request):
    _, control = paths(name)
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(75)
        client.connect(str(control / 'control.sock'))
        client.sendall(json.dumps(request).encode() + b'\n')
        data = b''
        while b'\n' not in data:
            part = client.recv(65536)
            if not part: raise RuntimeError('Laboratório encerrou a conexão')
            data += part
            if len(data) > 2_000_000: raise RuntimeError('Resposta excedeu o limite')
    return json.loads(data.split(b'\n')[0])

def main():
    if os.getuid() != pwd.getpwnam('codex-worker').pw_uid:
        raise SystemExit('Execute como codex-worker. O Sistema deve usar runuser pelo broker.')
    os.environ['XDG_RUNTIME_DIR'] = '/run/user/1001'
    os.environ['DBUS_SESSION_BUS_ADDRESS'] = 'unix:path=/run/user/1001/bus'
    p = argparse.ArgumentParser(description='Laboratório isolado no host SASOCQ; rede isolada; Internet por proxy público opcional.')
    sub = p.add_subparsers(dest='op', required=True)
    start = sub.add_parser('start'); start.add_argument('name', type=name_arg)
    start.add_argument('--profile',choices=('generic','roblox'),default='generic'); start.add_argument('--internet', action='store_true'); start.add_argument('--wine', action='store_true'); start.add_argument('--gui', action='store_true'); start.add_argument('--gpu', action='store_true')
    start.add_argument('--minutes', type=int, default=30, choices=range(1,121), metavar='1..120')
    for op in ('stop', 'status', 'screenshot'):
        sub.add_parser(op).add_argument('name', type=name_arg)
    for op in ('exec', 'launch'):
        q = sub.add_parser(op); q.add_argument('name', type=name_arg); q.add_argument('argv', nargs=argparse.REMAINDER)
    for operation in ('import-vm','import-local'):
        imp=sub.add_parser(operation); imp.add_argument('name',type=name_arg)
        imp.add_argument('--project',required=True); imp.add_argument('--prefix',default='wine-visual-review')
        imp.add_argument('--place',default='execution-preview.rbxlx')
    roblox=sub.add_parser('roblox'); roblox.add_argument('name',type=name_arg)
    roblox.add_argument('--home',action='store_true')
    roblox.add_argument('--file',type=pathlib.Path,help='Copia uma prévia local .rbxl/.rbxlx para a área, sem alterar a origem')
    sub.add_parser('list')
    a = p.parse_args()
    if a.op == 'list':
        subprocess.run(['systemctl','--user','list-units','--all','--no-pager','sasocq-lab-*.service']); return
    work, control = paths(a.name)
    if a.op in ('import-vm','import-local'):
        sys.path.insert(0,str(LIB))
        from migrate import import_vm
        import_vm(a.name,a.project,a.prefix,a.place,local_only=a.op=='import-local'); return
    if a.op=='roblox':
        metadata=json.loads((work/'vm-import/manifest.json').read_text())
        if subprocess.run(['systemctl','--user','is-active','--quiet',unit(a.name)]).returncode:
            subprocess.run([sys.argv[0],'start',a.name,'--profile','roblox'],check=True)
        status=call(a.name,{'op':'status'})
        if status.get('profile')!='roblox': raise RuntimeError('Área ativa não usa o perfil Roblox')
        prefix=metadata['prefix']; place=metadata['place']
        if not re.fullmatch(r'wine-[a-z0-9-]{1,60}',prefix) or not re.fullmatch(r'[A-Za-z0-9_.-]{1,120}\.rbxlx?',place):
            raise RuntimeError('Manifesto inválido')
        selected='/work/vm-import/test-client/'+place
        if a.file:
            import hashlib, shutil
            src=a.file.resolve(strict=True)
            if src.suffix.lower() not in ('.rbxl','.rbxlx') or not src.is_file() or src.stat().st_size>256*1024**2:
                raise RuntimeError('Use um arquivo de place regular de até 256 MiB')
            inputs=work/'inputs'
            if inputs.is_symlink(): raise RuntimeError('Pasta inputs inválida')
            inputs.mkdir(mode=0o700,exist_ok=True)
            data=src.read_bytes(); digest=hashlib.sha256(data).hexdigest()
            target=inputs/(digest[:16]+'-'+src.name)
            if target.is_symlink(): raise RuntimeError('Arquivo de destino inválido')
            if not target.exists():
                with target.open('xb') as output: output.write(data)
            selected='/work/inputs/'+target.name
        argv=['/lab/bin/roblox-studio'] + ([] if a.home else [selected])
        value=call(a.name,{'op':'launch','argv':argv})
        print(json.dumps(value,ensure_ascii=False))
        if not value.get('ok',True): raise SystemExit(1)
        return
    if a.op == 'start':
        if a.profile=='roblox': a.gui=a.wine=a.internet=True
        for path in (work, control):
            if path.is_symlink(): raise RuntimeError('Pasta do laboratório não pode ser link')
            path.mkdir(mode=0o700, parents=True, exist_ok=True)
            if path.stat().st_uid != os.getuid(): raise RuntimeError('Proprietário de pasta inválido')
            path.chmod(0o700)
        if subprocess.run(['systemctl','--user','is-active','--quiet',unit(a.name)]).returncode == 0:
            raise RuntimeError('Laboratório já ativo; reutilize-o ou encerre antes de iniciar novamente')
        if __import__('shutil').disk_usage(ROOT).free < 50 * 1024**3:
            raise RuntimeError('Reserva de disco do host abaixo de 50 GiB')
        subprocess.run(['systemctl','--user','reset-failed',unit(a.name)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        cmd = ['systemd-run','--user','--quiet','--collect','--service-type=exec','--unit='+unit(a.name),'--slice='+SLICE,
            '-p','CPUAccounting=yes','-p','MemoryAccounting=yes','-p','IOAccounting=yes',
            '-p','CPUWeight=100','-p','IOWeight=100','-p','OOMScoreAdjust=700','-p','OOMPolicy=stop',
            '-p','KillMode=control-group','-p','TimeoutStopSec=10','-p','RuntimeMaxSec='+str(a.minutes*60),
            '-p','Restart=no','-p','UMask=0077','-p','LimitCORE=0','-p','LimitFSIZE=4G',
            str(LIB/'supervisor.py'),a.name] + (['--gui'] if a.gui else []) + (['--gpu'] if a.gpu else []) + (['--wine'] if a.wine else []) + (['--internet'] if a.internet else []) + (['--roblox'] if a.profile=='roblox' else [])
        subprocess.run(cmd, check=True)
        for _ in range(80):
            try:
                value=call(a.name, {'op':'status'})
                print(json.dumps({**value,'host_path':str(work),'expires_in_minutes':a.minutes},ensure_ascii=False)); return
            except (OSError,RuntimeError): time.sleep(.1)
        subprocess.run(['systemctl','--user','stop',unit(a.name)])
        raise RuntimeError('Laboratório não iniciou. Consulte journalctl --user -u '+unit(a.name))
    if a.op == 'stop':
        subprocess.run(['systemctl','--user','stop',unit(a.name)],check=True)
        print(json.dumps({'stopped':True,'files_preserved':str(work)})); return
    if a.op == 'status':
        result = subprocess.run(['systemctl','--user','show',unit(a.name),'--property=ActiveState,SubState,ControlGroup,MemoryCurrent,CPUUsageNSec,TasksCurrent,Result'],capture_output=True,text=True)
        print(result.stdout,end='')
        if 'ActiveState=active' in result.stdout: print(json.dumps(call(a.name,{'op':'status'}),ensure_ascii=False))
        return
    if a.op in ('exec','launch'):
        argv=a.argv[1:] if a.argv[:1]==['--'] else a.argv
        if not argv: raise RuntimeError('Comando obrigatório após --')
        value=call(a.name,{'op':a.op,'argv':argv})
    else: value=call(a.name,{'op':'screenshot'})
    print(json.dumps(value,ensure_ascii=False))
    if not value.get('ok',True): raise SystemExit(1)
    if a.op=='exec': raise SystemExit(value.get('returncode',0))

if __name__=='__main__':
    try: main()
    except (OSError,ValueError,RuntimeError,subprocess.SubprocessError) as e: sys.exit(str(e))
