#!/bin/bash
set -Eeuo pipefail

MODE="projects"
INSTALL_CODEX="yes"
START_SERVICE="yes"
ENABLE_TAILSCALE="no"
PACKAGE_ROOT="${DEX_REMOTE_PACKAGE_ROOT:-}"
STATE_ROOT="${DEX_REMOTE_STATE_ROOT:-}"
CODEX_VERSION_FILE="${PACKAGE_ROOT}/opt/dex-remote/CODEX_CLI_VERSION"
[[ -f "$CODEX_VERSION_FILE" ]] || CODEX_VERSION_FILE="/opt/dex-remote/CODEX_CLI_VERSION"
CODEX_CLI_VERSION="$(tr -d '[:space:]' <"$CODEX_VERSION_FILE")"
[[ "$CODEX_CLI_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]] || {
  echo "Versão fixada do Codex CLI inválida." >&2
  exit 65
}

usage() {
  cat <<'EOF'
Uso: dex-remote-setup [opções]

  --mode projects|full|sasocq  Projetos, Sistema portátil ou Control Plane SASOCQ
  --install-codex        Instala/atualiza o Codex CLI nas contas do Dex
  --skip-codex           Não acessa a rede durante a configuração
  --no-start             Não inicia o serviço ao final
  --enable-tailscale     Instala/conecta Tailscale e publica o Dex privadamente
  --help                 Mostra esta ajuda

O perfil full cria o usuário codex com sudo integral sem senha.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode)
      [[ $# -ge 2 ]] || { echo "--mode exige um valor" >&2; exit 64; }
      MODE="$2"
      shift 2
      ;;
    --install-codex) INSTALL_CODEX="yes"; shift ;;
    --skip-codex) INSTALL_CODEX="no"; shift ;;
    --no-start) START_SERVICE="no"; shift ;;
    --enable-tailscale) ENABLE_TAILSCALE="yes"; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Opção desconhecida: $1" >&2; usage >&2; exit 64 ;;
  esac
done

[[ "$MODE" == "projects" || "$MODE" == "full" || "$MODE" == "sasocq" ]] || {
  echo "Modo inválido: use projects, full ou sasocq" >&2
  exit 64
}

if [[ -z "$STATE_ROOT" && "$(id -u)" -ne 0 ]]; then
  echo "Execute este configurador com sudo." >&2
  exit 77
fi

root_path() {
  printf '%s%s' "$STATE_ROOT" "$1"
}

CONTROLLER_USER="codex-worker"
PROJECT_USER="codex-worker"
if [[ "$MODE" != "projects" ]]; then
  CONTROLLER_USER="codex"
fi

user_home() {
  if [[ -n "$STATE_ROOT" ]]; then
    printf '%s/home/%s' "$STATE_ROOT" "$1"
  else
    getent passwd "$1" | cut -d: -f6
  fi
}

ensure_user() {
  local account="$1"
  if [[ -n "$STATE_ROOT" ]]; then
    install -d -m 0755 "$(root_path /home)"
    install -d -m 0700 "$(user_home "$account")"
    return
  fi
  if ! getent passwd "$account" >/dev/null; then
    useradd --create-home --shell /bin/bash --user-group "$account"
  fi
  passwd --lock "$account" >/dev/null 2>&1 || true
}

write_file() {
  local destination="$1" mode="$2"
  local temporary
  install -d -m 0755 "$(dirname "$destination")"
  temporary="$(mktemp "${destination}.tmp.XXXXXX")"
  cat >"$temporary"
  chmod "$mode" "$temporary"
  mv -f "$temporary" "$destination"
}

ensure_user "$PROJECT_USER"
if [[ "$MODE" != "projects" ]]; then
  ensure_user "$CONTROLLER_USER"
fi

SUDOERS="$(root_path /etc/sudoers.d/dex-remote-system)"
if [[ "$MODE" != "projects" ]]; then
  if [[ -z "$STATE_ROOT" ]]; then
    usermod --append --groups sudo "$CONTROLLER_USER"
  fi
  write_file "$SUDOERS" 0440 <<EOF
# Criado por dex-remote-setup: escolha explícita do perfil Sistema + Projetos.
$CONTROLLER_USER ALL=(ALL:ALL) NOPASSWD: ALL
EOF
  if [[ -z "$STATE_ROOT" ]] && command -v visudo >/dev/null; then
    visudo -cf "$SUDOERS" >/dev/null
  fi
else
  rm -f "$SUDOERS"
  if [[ -z "$STATE_ROOT" ]] && id -nG "$CONTROLLER_USER" | tr ' ' '\n' | grep -qx sudo; then
    echo "Aviso: $CONTROLLER_USER já pertencia ao grupo sudo; o instalador não remove privilégios preexistentes." >&2
  fi
fi

CONTROLLER_HOME="$(user_home "$CONTROLLER_USER")"
PROJECT_HOME="$(user_home "$PROJECT_USER")"
PROJECT_ROOT="$PROJECT_HOME/CodexProjects"
[[ "$MODE" != "sasocq" ]] || PROJECT_ROOT="$(root_path /srv/sasocq/projects)"
SYSTEM_ROOT="$CONTROLLER_HOME/SystemWorkspace"
CONFIG_DIR="$CONTROLLER_HOME/.config/codex-linux-control"
CONFIG_FILE="$CONFIG_DIR/config.json"

install -d -m 0700 "$CONFIG_DIR" "$CONTROLLER_HOME/.codex"
install -d -m 0750 "$PROJECT_ROOT" "$PROJECT_HOME/.codex"
if [[ "$MODE" != "projects" ]]; then
  install -d -m 0750 "$SYSTEM_ROOT"
fi

if [[ -z "$STATE_ROOT" ]]; then
  chown -R "$CONTROLLER_USER:$CONTROLLER_USER" "$CONFIG_DIR" "$CONTROLLER_HOME/.codex"
  chown -R "$PROJECT_USER:$PROJECT_USER" "$PROJECT_ROOT" "$PROJECT_HOME/.codex"
  [[ "$MODE" == "projects" ]] || chown -R "$CONTROLLER_USER:$CONTROLLER_USER" "$SYSTEM_ROOT"
fi

if [[ "$MODE" != "projects" ]]; then
  PROJECT_COMMAND="/usr/bin/sudo -n -u $PROJECT_USER -- /usr/lib/dex-remote/run-project-app-server"
  CODEX_COMMAND="$CONTROLLER_HOME/.local/bin/codex app-server"
else
  PROJECT_COMMAND="/usr/lib/dex-remote/run-project-app-server"
  CODEX_COMMAND="$PROJECT_HOME/.local/bin/codex app-server"
  SYSTEM_ROOT="$PROJECT_HOME/.local/share/dex-remote/internal"
fi

REMOTE_ENABLED=false
FULL_EXPERIENCE=false
DESKTOP_CONTROL=false
BROWSER_CONTROL=false
REMOTE_DESKTOP=false
CONTROL_PLANE=false
ENTRA_ENABLED=false
CLOUDFLARE_ACCESS=false
EXTERNAL_URL=""
REQUIRE_PAIRED_LOCAL=false
PLAYWRIGHT_INTERNAL=false
if [[ "$MODE" == "sasocq" ]]; then
  REMOTE_ENABLED=true
  FULL_EXPERIENCE=true
  DESKTOP_CONTROL=true
  BROWSER_CONTROL=true
  REMOTE_DESKTOP=true
  CONTROL_PLANE=true
  ENTRA_ENABLED=true
  CLOUDFLARE_ACCESS=true
  EXTERNAL_URL="https://dex.sasocq.com"
  REQUIRE_PAIRED_LOCAL=true
  PLAYWRIGHT_INTERNAL=true
fi

write_file "$CONFIG_FILE" 0600 <<EOF
{
  "install_mode": "$MODE",
  "setup_completed": true,
  "start_at_login": true,
  "codex_command": "$CODEX_COMMAND",
  "project_codex_command": "$PROJECT_COMMAND",
  "project_worker_user": "$PROJECT_USER",
  "project_worker_home": "$PROJECT_HOME",
  "system_workspace_path": "$SYSTEM_ROOT",
  "allowed_project_roots": "$PROJECT_ROOT",
  "projects_file": "$CONFIG_DIR/projects.json",
  "allow_localhost": true,
  "require_paired_local": $REQUIRE_PAIRED_LOCAL,
  "remote_enabled": $REMOTE_ENABLED,
  "external_url": "$EXTERNAL_URL",
  "full_experience_installed": $FULL_EXPERIENCE,
  "desktop_control_enabled": $DESKTOP_CONTROL,
  "browser_control_enabled": $BROWSER_CONTROL,
  "playwright_internal_access_enabled": $PLAYWRIGHT_INTERNAL,
  "remote_desktop_enabled": $REMOTE_DESKTOP,
  "device_auth_required": true,
  "control_plane_enabled": $CONTROL_PLANE,
  "entra_enabled": $ENTRA_ENABLED,
  "cloudflare_access_enabled": $CLOUDFLARE_ACCESS,
  "privileged_helper": "/usr/lib/dex-remote/clc-admin",
  "service_name": "dex-remote@$CONTROLLER_USER.service"
}
EOF

write_file "$PROJECT_ROOT/AGENTS.md" 0644 <<'EOF'
# Preferências locais do Codex de Projetos

- Trabalhe somente nas pastas de projetos autorizadas.
- Não tente obter administração do sistema ou contornar a separação de usuários.
- Preserve dados, faça backup antes de mudanças de risco e valide o resultado real.
- Serviços publicados por esta distribuição usam endereços do domínio sasocq.com.
EOF

if [[ "$MODE" != "projects" ]]; then
  write_file "$SYSTEM_ROOT/AGENTS.md" 0644 <<'EOF'
# Preferências locais do Codex do Sistema

- Esta identidade possui sudo integral sem senha por escolha feita na instalação.
- Leia estado e logs antes de alterar serviços; preserve dados e backups.
- Peça confirmação antes de apagar dados, formatar discos, reiniciar ou desligar.
- Valide o fluxo real depois de cada mudança.
- Serviços publicados por esta distribuição usam endereços do domínio sasocq.com.
EOF
fi

if [[ -z "$STATE_ROOT" ]]; then
  chown "$CONTROLLER_USER:$CONTROLLER_USER" "$CONFIG_FILE"
  chown -R "$PROJECT_USER:$PROJECT_USER" "$PROJECT_ROOT"
  [[ "$MODE" == "projects" ]] || chown -R "$CONTROLLER_USER:$CONTROLLER_USER" "$SYSTEM_ROOT"
fi

install_codex_for() {
  local account="$1" home="$2"
  local installer
  if [[ -x "$home/.local/bin/codex" ]]; then
    echo "Codex CLI já está instalado para $account; atualizando pelo instalador oficial."
  else
    echo "Instalando Codex CLI para $account pelo instalador oficial da OpenAI."
  fi
  installer="$(mktemp /tmp/dex-remote-codex.XXXXXX)"
  if ! curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
      https://chatgpt.com/codex/install.sh --output "$installer"; then
    rm -f "$installer"
    return 1
  fi
  chmod 0755 "$installer"
  if ! runuser -u "$account" -- env HOME="$home" USER="$account" LOGNAME="$account" \
      CODEX_NON_INTERACTIVE=true CODEX_INSTALL_DIR="$home/.local/bin" sh "$installer" --release "$CODEX_CLI_VERSION"; then
    rm -f "$installer"
    return 1
  fi
  rm -f "$installer"
  [[ -x "$home/.local/bin/codex" ]]
}

PENDING="$(root_path /var/lib/dex-remote/codex-install.pending)"
install -d -m 0755 "$(dirname "$PENDING")"
if [[ "$INSTALL_CODEX" == "yes" && -z "$STATE_ROOT" ]]; then
  FAILED="no"
  install_codex_for "$PROJECT_USER" "$PROJECT_HOME" || FAILED="yes"
  if [[ "$MODE" != "projects" ]]; then
    install_codex_for "$CONTROLLER_USER" "$CONTROLLER_HOME" || FAILED="yes"
  fi
  if [[ "$FAILED" == "yes" ]]; then
    printf '%s\n' "Execute: sudo dex-remote-setup --mode $MODE --install-codex" >"$PENDING"
    echo "Aviso: o Codex CLI não pôde ser instalado agora; a configuração local foi preservada." >&2
  else
    rm -f "$PENDING"
  fi
else
  printf '%s\n' "Execute: sudo dex-remote-setup --mode $MODE --install-codex" >"$PENDING"
fi

ACTIVE_USER_FILE="$(root_path /etc/dex-remote/active-user)"
PREVIOUS_USER=""
[[ ! -f "$ACTIVE_USER_FILE" ]] || PREVIOUS_USER="$(tr -cd 'A-Za-z0-9._-' <"$ACTIVE_USER_FILE")"
write_file "$ACTIVE_USER_FILE" 0644 <<EOF
$CONTROLLER_USER
EOF
write_file "$(root_path /etc/dex-remote/install-mode)" 0644 <<EOF
$MODE
EOF

if [[ -z "$STATE_ROOT" ]]; then
  systemctl daemon-reload
  if [[ -n "$PREVIOUS_USER" && "$PREVIOUS_USER" != "$CONTROLLER_USER" ]]; then
    systemctl disable --now "dex-remote@$PREVIOUS_USER.service" >/dev/null 2>&1 || true
  fi
  systemctl enable "dex-remote@$CONTROLLER_USER.service"
  if [[ "$START_SERVICE" == "yes" ]]; then
    systemctl restart "dex-remote@$CONTROLLER_USER.service"
  fi
fi

if [[ "$ENABLE_TAILSCALE" == "yes" ]]; then
  [[ -z "$STATE_ROOT" ]] || { echo "Tailscale não é executado no modo de teste." >&2; exit 78; }
  if ! command -v tailscale >/dev/null; then
    tailscale_installer="$(mktemp /tmp/dex-remote-tailscale.XXXXXX)"
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
      https://tailscale.com/install.sh --output "$tailscale_installer"
    chmod 0700 "$tailscale_installer"
    sh "$tailscale_installer"
    rm -f "$tailscale_installer"
  fi
  systemctl enable --now tailscaled.service
  tailscale up
  tailscale serve --bg http://127.0.0.1:8787
fi

echo "Dex Remoto configurado no perfil $MODE com Codex CLI $CODEX_CLI_VERSION."
echo "Abra http://127.0.0.1:8787 neste computador para autenticar as contas OpenAI."
if [[ "$MODE" != "projects" ]]; then
  echo "Atenção: o usuário $CONTROLLER_USER possui sudo integral sem senha."
fi
echo "Para acesso privado remoto: sudo dex-remote-setup --mode $MODE --skip-codex --enable-tailscale"
