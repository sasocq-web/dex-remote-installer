#!/bin/bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dex-remote-installer"
LOCK_FILE="$STATE_DIR/publish.lock"
TRIGGER_BACKUP="no"
CONFIRM_BACKUP="no"
WORK_ROOT=""
SYNC_PERFORMED="no"
BACKUP_MARKER="$STATE_DIR/backup-required"

usage() {
  cat <<'EOF'
Uso: publish-after-backup [--trigger-backup-on-change] [--confirm-backed-up]

Sincroniza a release Dex mais recente com o GitHub e com o bundle local.
Quando solicitado, dispara pelo broker um backup auditável se o bundle mudou.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --trigger-backup-on-change) TRIGGER_BACKUP="yes"; shift ;;
    --confirm-backed-up) CONFIRM_BACKUP="yes"; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Opção desconhecida: $1" >&2; usage >&2; exit 64 ;;
  esac
done

bundle_digest() {
  [[ -f "$ROOT/recovery/dex-current/manifest.json" ]] || return 0
  sha256sum "$ROOT/recovery/dex-current/manifest.json" | awk '{print $1}'
}

cleanup() {
  local rc=$? final_digest proof
  trap - EXIT
  [[ -z "$WORK_ROOT" ]] || rm -rf -- "$WORK_ROOT"
  final_digest="$(bundle_digest)"
  if [[ $rc -eq 0 && "$SYNC_PERFORMED" == "yes" ]] && \
     [[ "$TRIGGER_BACKUP" == "yes" || "$CONFIRM_BACKUP" == "yes" ]]; then
    proof="$(mktemp "$STATE_DIR/verification.XXXXXX")"
    if sasocq-brokerctl host-admin '{"operation":"exec","argv":["/usr/lib/sasocq-control/verify-dex-recovery"],"timeout":120}' >"$proof"; then
      mv -f -- "$proof" "$STATE_DIR/backup-confirmed.json"
      rm -f -- "$BACKUP_MARKER"
      echo "Conteúdo do reinstalador conferido no snapshot remoto."
    else
      mv -f -- "$proof" "$STATE_DIR/backup-verification-failed.json"
      printf '%s\n' "${final_digest:-unverified}" >"$BACKUP_MARKER"
      chmod 0600 "$BACKUP_MARKER"
      echo "Snapshot remoto ainda não corresponde ao reinstalador atual; pendência preservada." >&2
      # ExecStartPost still belongs to the running backup unit: starting that
      # unit here coalesces with the old job. The persistent retry timer handles
      # this case after it has finished, without silently losing the request.
      if [[ "$CONFIRM_BACKUP" == "yes" ]]; then
        rc=1
      elif ! sasocq-brokerctl backup '{"operation":"run"}' >/dev/null; then
        rc=1
      fi
    fi
  fi
  exit "$rc"
}
trap cleanup EXIT

install -d -m 0700 "$STATE_DIR"
exec 9>"$LOCK_FILE"
if ! flock -w 120 9; then
  echo "A publicação do Dex Remote Installer já está em execução."
  exit 75
fi
SYNC_PERFORMED="yes"

command -v gh >/dev/null || { echo "Cliente gh não instalado; publicação adiada." >&2; exit 69; }
gh auth status --hostname github.com >/dev/null 2>&1 || {
  echo "GitHub não autenticado; publicação adiada sem afetar o backup." >&2
  exit 77
}
[[ -d "$ROOT/.git" ]] || { echo "Repositório Git local ainda não inicializado." >&2; exit 69; }

ORIGIN="$(git -C "$ROOT" remote get-url origin)"
[[ -n "$ORIGIN" ]] || { echo "Remote origin ausente." >&2; exit 69; }
REPOSITORY="$(gh repo view "$ORIGIN" --json nameWithOwner --jq .nameWithOwner)"
WORK_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/dex-publish.XXXXXX")"

git clone --quiet "$ORIGIN" "$WORK_ROOT/repo"
WORK="$WORK_ROOT/repo"
git -C "$WORK" config user.name "SASOCQ Release Automation"
git -C "$WORK" config user.email "packages@sasocq.com"

refresh_local_bundle() {
  git -C "$ROOT" pull --ff-only origin main
  gh release download "$TAG" --repo "$REPOSITORY" --dir "$ROOT/dist" --clobber \
    --pattern "dex-remote-installer_${VERSION}_all.deb" \
    --pattern "dex-remote-installer_${VERSION}_all.deb.sha256" \
    --pattern "sasocq-control-plane_*_all.deb" \
    --pattern "sasocq-control-plane_*_all.deb.sha256"
  "$ROOT/tests/test-package.sh"
  "$ROOT/scripts/create-recovery-bundle"
}

set +e
MERGE_OUTPUT="$($WORK/scripts/merge-dex-upstream 2>&1)"
MERGE_STATUS=$?
set -e
if [[ $MERGE_STATUS -ne 0 && $MERGE_STATUS -ne 3 ]]; then
  echo "$MERGE_OUTPUT" >&2
  exit "$MERGE_STATUS"
fi

VERSION="$(tr -d '[:space:]' <"$WORK/PACKAGE_VERSION")"
TAG="v$VERSION"
if [[ $MERGE_STATUS -eq 3 ]] && gh release view "$TAG" --repo "$REPOSITORY" >/dev/null 2>&1; then
  refresh_local_bundle
  echo "Dex $TAG já está publicado; artefatos locais verificados."
  exit 0
fi

"$WORK/build.sh"
DEB="$WORK/dist/dex-remote-installer_${VERSION}_all.deb"
SHA="$DEB.sha256"
CONTROL_VERSION="$(tr -d '[:space:]' <"$WORK/CONTROL_PLANE_VERSION")"
CONTROL_SOURCE="$ROOT/../sasocq-control-plane_${CONTROL_VERSION}_all.deb"
CONTROL_DEB="$WORK/dist/sasocq-control-plane_${CONTROL_VERSION}_all.deb"
CONTROL_SHA="$CONTROL_DEB.sha256"
[[ -f "$CONTROL_SOURCE" ]] || { echo "Pacote do Control Plane SASOCQ ausente: $CONTROL_SOURCE" >&2; exit 66; }
install -m 0644 "$CONTROL_SOURCE" "$CONTROL_DEB"
(cd "$WORK/dist" && sha256sum "$(basename "$CONTROL_DEB")" >"$(basename "$CONTROL_SHA")")
"$WORK/tests/test-package.sh"

if [[ $MERGE_STATUS -eq 0 ]]; then
  git -C "$WORK" add --all
  git -C "$WORK" commit -m "chore: sincroniza Dex $(tr -d '[:space:]' <"$WORK/.dex-upstream-release")"
  git -C "$WORK" push origin HEAD:main
fi

if ! gh release view "$TAG" --repo "$REPOSITORY" >/dev/null 2>&1; then
  RELEASE_ID="$(tr -d '[:space:]' <"$WORK/.dex-upstream-release")"
  gh release create "$TAG" "$DEB" "$SHA" "$CONTROL_DEB" "$CONTROL_SHA" \
    --repo "$REPOSITORY" \
    --title "Dex Remote Installer $VERSION" \
    --notes "Pacote sincronizado com a release Dex ${RELEASE_ID}. Inclui os perfis Projetos, Sistema portátil e Control Plane SASOCQ. Os SHA-256 acompanham os downloads." \
    --latest
fi

refresh_local_bundle
echo "Dex Remote Installer $VERSION publicado; artefatos locais verificados."
