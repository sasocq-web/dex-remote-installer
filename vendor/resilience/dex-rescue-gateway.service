[Unit]
Description=Independent Dex recovery front door
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /usr/local/lib/dex-rescue/recovery_gateway.py
Environment=PATH=/home/codex/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
UMask=0077
Slice=app.slice
Restart=always
RestartSec=2
MemoryMax=128M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=default.target
