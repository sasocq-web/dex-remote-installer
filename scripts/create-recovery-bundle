#!/bin/bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="$(tr -d '[:space:]' <"$ROOT/PACKAGE_VERSION")"
DESTINATION="${1:-$ROOT/recovery/dex-current}"
DEB="$ROOT/dist/dex-remote-installer_${VERSION}_all.deb"
SHA="$DEB.sha256"
[[ -f "$DEB" && -f "$SHA" ]] || { echo "Compile o pacote antes de gerar o bundle." >&2; exit 66; }

install -d -m 0755 "$DESTINATION"
install -m 0644 "$DEB" "$SHA" "$ROOT/CODEX_CLI_VERSION" "$DESTINATION/"
install -m 0755 "$ROOT/install.sh" "$DESTINATION/install-core"
install -m 0755 "$ROOT/scripts/reinstall-from-bundle" "$DESTINATION/reinstall"
python3 - "$ROOT" "$DESTINATION/manifest.json" <<'PY'
import hashlib, json, pathlib, sys, time
root, destination = map(pathlib.Path, sys.argv[1:])
version = (root / "PACKAGE_VERSION").read_text().strip()
deb = root / "dist" / f"dex-remote-installer_{version}_all.deb"
manifest = {
    "format": 1,
    "created_at": time.time(),
    "package_version": version,
    "codex_cli_version": (root / "CODEX_CLI_VERSION").read_text().strip(),
    "dex_release": (root / ".dex-upstream-release").read_text().strip(),
    "package": deb.name,
    "sha256": hashlib.sha256(deb.read_bytes()).hexdigest(),
    "contains_secrets": False,
}
destination.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
PY
echo "$DESTINATION"
